# ═══════════════════════════════════════════════════════════════
# .env.example — Cấu hình môi trường HTX Rau An Toàn Túy Loan
# Sao chép file này thành .env hoặc .env.local và điền giá trị thực
# ═══════════════════════════════════════════════════════════════

# ── Cấu hình Core (Bắt buộc) ──────────────────────────────────
NODE_ENV=development
# Payload Secret: Khóa bí mật mã hóa JWT session (Production bắt buộc chuỗi ngẫu nhiên dài)
PAYLOAD_SECRET=your-super-secret-key-change-this-in-production

# URL website chính
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cơ sở dữ liệu (Database) ──────────────────────────────────
# Để trống DATABASE_URI sẽ tự động dùng SQLite local: payload-data.db
# Trên Coolify/Production điền connection string PostgreSQL:
# DATABASE_URI=postgresql://postgres:password@postgresql:5432/htxraudb

# ── Quản trị & Seeding tài khoản mẫu ─────────────────────────
# Đặt true nếu muốn tự động tạo các tài khoản test (admin@test.com, editor@test.com...)
SEED_TEST_ACCOUNTS=false

# ── Telegram Bot (Thông báo đơn hàng mới) ─────────────────────
# 1. Tìm @BotFather trên Telegram -> /newbot -> lấy bot token
# 2. Lấy Chat ID qua https://api.telegram.org/bot<TOKEN>/getUpdates hoặc @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email SMTP (Thông báo đơn hàng qua email) ─────────────────
# Sử dụng Gmail App Password (16 ký tự):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=htxtuyloandanang@gmail.com

# ── Lưu trữ Cloud Media (Tùy chọn - AWS S3 / Cloudflare R2 / Vercel Blob) ───
# BLOB_READ_WRITE_TOKEN=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_PUBLIC_URL=
